# Copy to .env to use it (cp .env.example .env). Works without it, using the defaults in docker-compose.yml.
API_PORT=5080
# Set to Production to disable the API docs (/scalar/v1)
ASPNETCORE_ENVIRONMENT=Development
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_PASSWORD=apppass
# At least 32 bytes. Always change this in production
JWT_KEY=dev-only-secret-change-me-0123456789abcdef
